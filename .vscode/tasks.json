{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "World Smith: Run (Debug)",
            "type": "process",
            "command": "cargo",
            "args": ["run"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "World Smith: Run (Release)",
            "type": "process",
            "command": "cargo",
            "args": ["run", "--release"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "World Smith: Test",
            "type": "process",
            "command": "cargo",
            "args": ["test"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "World Smith: Build (Release)",
            "type": "process",
            "command": "cargo",
            "args": ["build", "--release"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$rustc"
        }
    ]
}
